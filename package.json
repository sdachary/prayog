{
  "name": "prayog",
  "version": "1.0.0",
  "description": "Prayog - Static site",
  "private": true,
  "scripts": {
    "test": "node --test test/orb-mapping.test.js",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint \"**/*.html\"",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:js": "eslint \"**/*.js\"",
    "check:links": "lychee --verbose --max-concurrency 10 \"**/*.html\"",
    "test:a11y": "playwright test test/accessibility.test.js || true",
    "test:visual": "playwright test test/visual-smoke.test.js || true"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "eslint": "^8.56.0",
    "htmlhint": "^1.1.4",
    "lychee": "^0.2.12",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
